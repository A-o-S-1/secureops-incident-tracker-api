# Copy to .env. Use a long random secret in every non-demo environment.
APP_NAME=SecureOps Incident Tracker API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./secureops.db
SECRET_KEY=REPLACE_WITH_OUTPUT_FROM_PYTHON_SECRETS_TOKEN_URLSAFE_48
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated exact frontend origins; leave blank if no browser frontend.
CORS_ORIGINS=
